{
  "manifest_version": 3,
  "name": "CS128 SideBySide",
  "version": "1.0.0",
  "description": "Open a CS128 activity workspace beside its lesson instructions.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://cs128.org/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "CS128 SideBySide",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cs128.org/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
